{
  "name": "review-desk",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,cyan \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend && npm run build -w backend",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run",
    "db:init": "npm run db:init -w backend",
    "db:reset": "npm run db:reset -w backend",
    "start": "npm run start -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
